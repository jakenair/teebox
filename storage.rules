rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // App Check guard. No-op until enabled — see the comment in
    // firestore.rules for the enable steps; once App Check is on,
    // change this to `return request.app != null;`.
    function appCheckOk() {
      return true;
    }

    // Admin allowlist — DEFENSE-IN-DEPTH backstop. Canonical source is
    // now the ADMIN_ALLOWLIST Firebase Secret consumed by Cloud
    // Function callables (see isAdminEmail()/adminGate() in
    // functions/index.js). Storage rules cannot read secrets, so this
    // hardcoded literal stays here as a second line of defense. Keep
    // in sync with firestore.rules isAdmin() and the secret value.
    // Used by the moderation queue's "Reject + delete" path so admin
    // can purge a flagged listing's photos directly from the client
    // without needing a callable function.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'jakenair23@gmail.com'
        ];
    }

    // Listing photos — path encodes sellerId so we don't need a cross-service
    // firestore.get() to check ownership. The old shape /listings/{listingId}
    // hit a consistency lag where rules couldn't see the just-created listing
    // doc; that lag manifested as a 403 on every photo upload.
    //   read:   public
    //   write:  signed-in user, ONLY to their own /listings/{uid}/... folder;
    //           max 5MB; only explicit raster image types (SVG blocked).
    //   delete: owner of the path, OR an admin (moderation reject).
    match /listings/{sellerId}/{listingId}/{fileName} {
      allow read: if true;

      allow write: if request.auth != null
        && appCheckOk()
        && request.auth.uid == sellerId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|heic|heif)');

      allow delete: if request.auth != null
        && appCheckOk()
        && (request.auth.uid == sellerId || isAdmin());
    }

    // Profile avatars
    //   read:   public
    //   write:  signed-in user, and only to their own avatars/{uid}/* path
    //           Max 2MB, raster image types only (no SVG).
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && appCheckOk()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|heic|heif)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Course-passport photos
    //   read:   public
    //   write:  signed-in user, only to their own passport/{uid}/... path.
    //           Max 5MB, raster image types (the client crops to ~1080px
    //           first, so real files are a fraction of this).
    match /passport/{userId}/{courseId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && appCheckOk()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Shared Passport rounds — the public copies made by sharePassportRound.
    //   read:   public (the share page is unauthenticated by design)
    //   write:  NOBODY. The callable writes these with the Admin SDK, which
    //           bypasses rules; no client may create, overwrite or delete one.
    //           unsharePassportRound is the only delete path.
    // These are w400/w800 WebP derivatives copied out of passport/, re-encoded
    // without metadata. The originals are never copied here, and the path
    // contains an opaque token rather than a uid — that is the whole point.
    match /sharedRounds/{token}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Course logos — the Logo Bingo / Passport artwork, served as a CDN.
    //   read:   public (unauthenticated; the puzzle doc hands these URLs to
    //           every client, signed in or not)
    //   write:  NOBODY from a client. These are uploaded by
    //           scripts/upload-logos-to-storage.mjs with admin credentials,
    //           which bypasses rules. Nothing a user does should ever be able
    //           to replace a course logo.
    //
    // WHY STORAGE AND NOT teeboxmarket.com (2026-10-02): the puzzle doc has
    // always carried absolute logo URLs so a stale app still renders current
    // artwork. That never worked in the app, because index.html's CSP did not
    // list https://teeboxmarket.com and in the WebView 'self' is
    // capacitor://localhost — so every tile failed and fell back to the PNG
    // bundled in the IPA, which is two revisions behind. r297 added
    // teeboxmarket.com to img-src, but a CSP ships inside the bundle, so that
    // only helps from the NEXT build onward.
    // firebasestorage.googleapis.com is ALREADY in the CSP of every installed
    // build. Serving logos from here fixes logo drift on phones people
    // already have, with no rebuild.
    match /course-logos/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
