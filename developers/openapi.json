{
  "openapi": "3.1.0",
  "info": {
    "title": "TeeBox Seller API",
    "version": "1.0.0",
    "description": "List, update and end a seller's items on TeeBox. Neither environment is open yet. No payment, payout, refund or order endpoints exist."
  },
  "servers": [
    {
      "url": "https://us-central1-teebox-market.cloudfunctions.net/sellerApi",
      "description": "Sandbox (open; test keys on request)"
    },
    {
      "url": "https://api.teeboxmarket.com",
      "description": "Live (not open yet)"
    }
  ],
  "security": [
    {
      "partnerKey": [],
      "connectionKey": []
    }
  ],
  "paths": {
    "/v1/me": {
      "get": {
        "operationId": "me",
        "summary": "Who this connection is",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "environment": {
                      "type": "string",
                      "enum": [
                        "live",
                        "sandbox"
                      ]
                    },
                    "partner": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "name": {
                          "type": "string"
                        }
                      }
                    },
                    "seller": {
                      "type": "object",
                      "properties": {
                        "display_name": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "can_list": {
                          "type": "boolean"
                        },
                        "cannot_list_reason": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "properties": {
                            "code": {
                              "type": "string"
                            },
                            "message": {
                              "type": "string"
                            }
                          }
                        },
                        "payouts_ready": {
                          "type": "boolean"
                        },
                        "daily_listing_limit": {
                          "type": "integer"
                        },
                        "listings_created_today": {
                          "type": "integer"
                        },
                        "daily_limit_resets_at": {
                          "type": [
                            "string",
                            "null"
                          ],
                          "format": "date-time"
                        }
                      }
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Codes: missing_partner_key, missing_connection_key, invalid_partner_key, invalid_connection_key, connection_revoked, wrong_environment, seller_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Codes: partner_disabled, connection_partner_mismatch, seller_disabled, seller_consent_required, seller_email_unverified, live_not_open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Codes: rate_limited, daily_limit_reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Codes: internal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/categories": {
      "get": {
        "operationId": "categories",
        "summary": "Categories, spec fields and listing rules",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "conditions": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "browse_categories": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "categories": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "browse_category": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "requires_browse_category": {
                            "type": "boolean"
                          },
                          "fields": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "key": {
                                  "type": "string"
                                },
                                "label": {
                                  "type": "string"
                                },
                                "type": {
                                  "type": "string",
                                  "enum": [
                                    "select",
                                    "text"
                                  ]
                                },
                                "required": {
                                  "type": "boolean"
                                },
                                "options": {
                                  "type": "array",
                                  "items": {
                                    "type": "string"
                                  }
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    "rules": {
                      "type": "object"
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Codes: missing_partner_key, missing_connection_key, invalid_partner_key, invalid_connection_key, connection_revoked, wrong_environment, seller_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Codes: partner_disabled, connection_partner_mismatch, seller_disabled, seller_consent_required, seller_email_unverified, live_not_open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Codes: rate_limited, daily_limit_reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Codes: internal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/listings": {
      "get": {
        "operationId": "list",
        "summary": "List the seller's listings, oldest change first",
        "parameters": [
          {
            "name": "updated_since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Comma-separated: active, reserved, sold, expired, ended, awaiting_payouts, needs_photos, under_review",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Listing"
                      }
                    },
                    "has_more": {
                      "type": "boolean"
                    },
                    "next_cursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "request_id": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Codes: invalid_json, unknown_field, empty_update, conflicting_fields, use_end, invalid_limit, invalid_status, invalid_updated_since, invalid_cursor, invalid_idempotency_key, seller_cannot_list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Codes: missing_partner_key, missing_connection_key, invalid_partner_key, invalid_connection_key, connection_revoked, wrong_environment, seller_not_found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Codes: partner_disabled, connection_partner_mismatch, seller_disabled, seller_consent_required, seller_email_unverified, live_not_open",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Codes: rate_limited, daily_limit_reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Codes: internal",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
