<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
        <string>TeeBox</string>
	<key>NSCameraUsageDescription</key>
	<string>TeeBox uses the camera to take photos of items you list for sale.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>TeeBox lets you choose photos from your library for your listings and your profile picture.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>TeeBox can save listing receipts and order confirmations to your photo library.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<!-- We register for APNs and forward the token to Firebase Auth manually
	     in AppDelegate.application(_:didRegisterForRemoteNotificationsWithDeviceToken:).
	     Disabling Firebase's auto-proxy stops it from competing with our handler,
	     which was eating the verificationId on phone-auth. -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>
	<!-- Google OAuth callback. The URL scheme MUST equal REVERSED_CLIENT_ID
	     from GoogleService-Info.plist (looks like com.googleusercontent.apps.NNN-XXX).
	     Re-download GoogleService-Info.plist from Firebase Console after enabling
	     Google Sign-In, then paste the REVERSED_CLIENT_ID below. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.982122063122-1pjjhvrnpcqhfvaumi9hlmvtsgnlm8kb</string>
			</array>
		</dict>
		<!-- Meta SDK callback scheme: fb + FacebookAppID (Facebook Login round-trip). -->
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb1869309951087087</string>
			</array>
		</dict>
	</array>
	<!-- Meta (Facebook) SDK — 2.6.1, 2026-10-28. Two uses: (1) App Events —
	     automatic App Install + App Launch for app-install ad attribution;
	     (2) Facebook Login via FBSDKLoginKit in LIMITED LOGIN mode (OIDC id token
	     + nonce, exchanged by exchangeIdTokenForCustomToken) — the only mode that
	     works without App Tracking Transparency consent, which this app never asks for.
	     FacebookClientToken is Meta's public client token (ships in every app's
	     plist; not a secret — Jake, 2026-10-28). The App Secret lives only in the
	     Firebase console's Facebook provider.
	     No App Tracking Transparency prompt exists in this app, so advertiser-ID
	     (IDFA) collection is OFF: attribution is SKAdNetwork-only. Do not flip
	     FacebookAdvertiserIDCollectionEnabled or add NSUserTrackingUsageDescription
	     without Jake's sign-off (privacy.html + App Privacy labels must move with it). -->
	<key>FacebookAppID</key>
	<string>1869309951087087</string>
	<key>FacebookClientToken</key>
	<string>8411978cc7e9cc285715bf2352bb2103</string>
	<key>FacebookDisplayName</key>
	<string>TeeBox</string>
	<key>FacebookAutoLogAppEventsEnabled</key>
	<true/>
	<key>FacebookAdvertiserIDCollectionEnabled</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fbapi</string>
		<string>fb-messenger-share-api</string>
	</array>
	<!-- Meta's published SKAdNetwork IDs (developers.facebook.com/docs/SKAdNetwork, read 2026-10-28). -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>v9wttpbfk9.skadnetwork</string>
		</dict>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>n38lu8286q.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
