require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '14.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorFirebaseAuthentication', :path => '../../node_modules/@capacitor-firebase/authentication'
  pod 'CapacitorApp', :path => '../../node_modules/@capacitor/app'
  pod 'CapacitorPushNotifications', :path => '../../node_modules/@capacitor/push-notifications'
  pod 'CapacitorShare', :path => '../../node_modules/@capacitor/share'
  pod 'CapacitorSplashScreen', :path => '../../node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../node_modules/@capacitor/status-bar'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
  # r186: the CapacitorFirebaseAuthentication/Google subspec was briefly
  # added here (2026-08-03) and REVERTED same day — r186 ships UI-only.
  # Native Google enablement is a standalone work item (see
  # .internal-docs/APP_UI_AUDIT_2026-08-02.md follow-up #6): it drags
  # GoogleSignIn 7.1.0 + a GTMSessionFetcher downgrade, and a prior
  # attempt (v1.5.0 b58, a582432) was itself rolled back to web-only
  # (6670525) — it must ship as an isolated release, one variable.
  # Firebase Crashlytics — iOS crash + non-fatal error reporting.
  # CapacitorFirebaseAuthentication transitively pulls FirebaseAuth ~> 11.7.0
  # (which drags FirebaseCore 11.7.x). Pin Crashlytics to the matching 11.7.x
  # line so CocoaPods doesn't try to bump FirebaseCore and create a version
  # conflict with FirebaseAuth's pin.
  pod 'FirebaseCrashlytics', '~> 11.7'
  # HIGH-1 Phase 1 — Firebase App Check (App Attest provider on iOS 14+,
  # DeviceCheck fallback for older). Pinned to the same 11.7 line as the
  # other Firebase pods so CocoaPods doesn't bump FirebaseCore. Phase 1 is
  # client-init only — server enforcement turns on in Phase 2 after 24-48h
  # of dashboard monitoring data confirms tokens flow on legitimate traffic.
  pod 'FirebaseAppCheck', '~> 11.7'
  # iOS push (APNs -> FCM). FirebaseMessaging receives the APNs token via the
  # manual bridge in AppDelegate (FirebaseAppDelegateProxyEnabled is false) and
  # mints the FCM registration token the server's sendEachForMulticast targets.
  # Pinned to the same 11.7 line as the other Firebase pods so CocoaPods doesn't
  # bump FirebaseCore and break FirebaseAuth's ~> 11.7.0 pin.
  pod 'FirebaseMessaging', '~> 11.7'
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # Xcode 16+/26 runs the CLANG MODULE VERIFIER over every Pod framework and
  # treats a double-quoted include inside a framework header as an ERROR, not a
  # warning. Three vendored pods use them — nanopb (pb.h, pb_common.h,
  # pb_decode.h, pb_encode.h), RecaptchaInterop (RCA*.h) and GTMSessionFetcher —
  # so the build fails on third-party source we neither own nor can patch:
  #
  #   error: double-quoted include "pb.h" in framework header,
  #          expected angle-bracketed instead
  #
  # Verification is a BUILD-TIME CHECK ONLY; it does not participate in codegen,
  # so turning it off changes nothing about the shipped binary. Scoped to
  # installer.pods_project, so the App target keeps its own warnings intact.
  #
  # Surfaced 2026-09-24 when a Release build was run for the first time since
  # CocoaPods regenerated Pods.xcodeproj under Xcode 26.3. NOT caused by the
  # "update to recommended settings" pass — reverting that left the build
  # failing identically, which is how it was traced here.
  # Exhaustive on purpose. An earlier version of this hook only walked
  # installer.pods_project.targets and left 62 of 84 build configurations still
  # set to YES — CocoaPods writes the setting in more places than that one list
  # reaches, and the archive failed on nanopb even though `pod install` had run.
  # So: project level, every target, every aggregate target, and finally a
  # literal sweep of the generated xcconfigs, which are the base layer the
  # pbxproj inherits from.
  projects = [installer.pods_project] + installer.generated_projects rescue [installer.pods_project]
  projects.compact.uniq.each do |proj|
    proj.build_configurations.each do |config|
      config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
    end
    proj.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['ENABLE_MODULE_VERIFIER'] = 'NO'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      end
    end
  end
  installer.aggregate_targets.each do |agg|
    agg.xcconfigs.each do |_name, cfg|
      cfg.attributes['ENABLE_MODULE_VERIFIER'] = 'NO'
      cfg.attributes['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
    end
  end
end
